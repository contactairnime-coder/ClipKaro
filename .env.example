# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL (via Supabase pooler)
DATABASE_URL=postgresql://postgres.project:password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.project:password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# NextAuth (legacy — kept for reference)
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_ACCOUNT_NUMBER=2323230029321278
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key

# Instagram Graph API
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Redis (Upstash free tier)
REDIS_URL=rediss://default:password@us1-available-ape-12345.upstash.io:6379

# Cron Jobs Secret
CRON_SECRET=your-random-cron-secret

# Resend (Email)
RESEND_API_KEY=re_xxxxxxxxxxxx
